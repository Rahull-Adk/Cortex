# Copy this file to .env and replace the values before starting Docker Compose.
ConnectionStrings__DefaultConnection=Host=host.docker.internal;Port=5432;Database=your_database;Username=your_user;Password=your_password
Jwt__Secret=replace-with-a-random-secret-at-least-32-characters-long
Jwt__Issuer=cortex-api
Jwt__Audience=cortex-frontend
GoogleAuth__ClientId=your-google-oauth-client-id.apps.googleusercontent.com
Brevo__ApiKey=your-brevo-api-key
Brevo__SenderEmail=verified-sender@example.com
Brevo__SenderName=Cortex
Frontend__BaseUrl=http://localhost:3000


