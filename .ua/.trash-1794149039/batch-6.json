{
  "nodes": [
    {
      "id": "service:.dockerignore",
      "type": "service",
      "name": ".dockerignore",
      "filePath": ".dockerignore",
      "summary": "Docker build-context exclusion list that keeps bin/obj build output, IDE folders, the git directory, the real .env secrets file and local appsettings overrides out of the API image.",
      "tags": [
        "containerization",
        "infrastructure",
        "security",
        "build-system"
      ],
      "complexity": "simple"
    },
    {
      "id": "service:Dockerfile",
      "type": "service",
      "name": "Dockerfile",
      "filePath": "Dockerfile",
      "summary": "Multi-stage Docker build that restores and publishes the Cortex.Api project with the .NET 10 SDK, then runs Cortex.Api.dll on the ASP.NET 10 runtime image exposing port 8080.",
      "tags": [
        "containerization",
        "infrastructure",
        "deployment",
        "dotnet"
      ],
      "complexity": "simple",
      "languageNotes": "Copies only the four .csproj files before running dotnet restore so the restore layer stays cached until project references or packages change."
    },
    {
      "id": "service:Dockerfile:build",
      "type": "service",
      "name": "build",
      "filePath": "Dockerfile",
      "summary": "Build stage based on the .NET 10 SDK image that restores Cortex.Api dependencies and publishes a Release build to /app/publish.",
      "tags": [
        "containerization",
        "build-system",
        "build-stage"
      ],
      "complexity": "simple",
      "lineRange": [
        1,
        12
      ]
    },
    {
      "id": "service:Dockerfile:runtime",
      "type": "service",
      "name": "runtime",
      "filePath": "Dockerfile",
      "summary": "Runtime stage based on the ASP.NET 10 image that copies the published output, exposes port 8080 and starts Cortex.Api.dll.",
      "tags": [
        "containerization",
        "deployment",
        "runtime-stage"
      ],
      "complexity": "simple",
      "lineRange": [
        13,
        18
      ]
    },
    {
      "id": "service:docker-compose.yml",
      "type": "service",
      "name": "docker-compose.yml",
      "filePath": "docker-compose.yml",
      "summary": "Docker Compose definition for local development that builds the API from the Dockerfile, injects database, JWT, Google OAuth, frontend URL and Brevo settings from .env (failing fast when required ones are missing), and maps host port 5203 to container port 8080.",
      "tags": [
        "orchestration",
        "infrastructure",
        "local-development",
        "configuration"
      ],
      "complexity": "simple",
      "languageNotes": "Uses ${VAR:?message} interpolation to abort startup when a required secret is unset and ${VAR:-default} for optional values; double-underscore keys map to nested ASP.NET Core configuration sections."
    },
    {
      "id": "service:docker-compose.yml:api",
      "type": "service",
      "name": "api",
      "filePath": "docker-compose.yml",
      "summary": "The single compose service running the Cortex ASP.NET Core API in Development mode; PostgreSQL is intentionally not included and must be provided by each developer.",
      "tags": [
        "orchestration",
        "api-service",
        "local-development"
      ],
      "complexity": "simple",
      "lineRange": [
        2,
        21
      ]
    }
  ],
