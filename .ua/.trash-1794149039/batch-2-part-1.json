  {
   "id": "file:Cortex.Api/Controllers/AuthController.cs",
   "type": "file",
   "name": "AuthController.cs",
   "filePath": "Cortex.Api/Controllers/AuthController.cs",
   "summary": "Thin ASP.NET Core API controller under /api/auth exposing register, login, Google session, email verification, refresh, logout and current-user endpoints; it delegates to AuthService, maps Result error codes to HTTP status codes, and sets HttpOnly JWT access/refresh cookies.",
   "tags": [
    "api-handler",
    "authentication",
    "controller",
    "entry-point",
    "cookies"
   ],
   "complexity": "moderate",
   "languageNotes": "Uses attribute routing ([Route], [HttpPost]) and a C# switch expression to translate error codes into IActionResult responses."
  },
  {
   "id": "file:Cortex.Application/Auth/AuthErrors.cs",
   "type": "file",
   "name": "AuthErrors.cs",
   "filePath": "Cortex.Application/Auth/AuthErrors.cs",
