   "tags": [
    "constants",
    "authentication",
    "error-handling"
   ],
   "complexity": "simple"
  },
  {
   "id": "file:Cortex.Application/Auth/AuthService.cs",
   "type": "file",
   "name": "AuthService.cs",
   "filePath": "Cortex.Application/Auth/AuthService.cs",
   "summary": "Core application service orchestrating the authentication use cases: credential registration and login, Google OAuth sign-in/account linking, email verification tokens, resending verification emails, refresh-token exchange and current-user lookup, all via injected repository and infrastructure abstractions.",
   "tags": [
    "service",
    "authentication",
    "use-case",
    "email-verification",
    "oauth"
   ],
   "complexity": "moderate",
   "languageNotes": "Returns a Result/Result<T> type instead of throwing for expected failures; verification tokens are generated with RandomNumberGenerator and stored only as SHA-256 hashes."
  },
